# Copy to .env.production on the server and fill in. Never commit .env.production.

# Domains (staging example: staging.spanfloors.com ; live: www.spanfloors.com)
SITE_DOMAIN=staging.spanfloors.com
BLOG_DOMAIN=
NEXT_PUBLIC_SITE_URL=https://staging.spanfloors.com

# Generate each secret with:  openssl rand -base64 32
POSTGRES_PASSWORD=
APP_SECRET=
CRON_SECRET=

# Twenty (read-only use; only website leads are created). Can also be set later in Admin → Integrations.
TWENTY_API_URL=https://api.twenty.com
TWENTY_API_KEY=
